{
  "name": "project-tracker",
  "version": "1.1.4",
  "private": true,
  "description": "Minimal project progress tracker, installable as an Android app with Capacitor.",
  "scripts": {
    "start": "python3 -m http.server 4173 --bind 0.0.0.0 --directory www",
    "build": "esbuild www/native-bridge.js --bundle --platform=browser --format=iife --outfile=www/native-bridge.bundle.js",
    "android:add": "npm run build && cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/local-notifications": "^7.0.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "esbuild": "^0.28.2"
  }
}
